[sub_resource type="GDScript" id=3]
script/source = "extends Camera2D

var zoom_f = zoom.x

func _unhandled_input(_event):
	if Input.is_action_just_pressed(\"scroll_down\"):
		zoom_f += 0.2
		zoom.x = zoom_f
		zoom.y = zoom_f
	if Input.is_action_just_pressed(\"scroll_up\"):
		zoom_f -= 0.2
		zoom.x = zoom_f
		zoom.y = zoom_f
"

