[sub_resource type="Shader" id=4]
code = "shader_type canvas_item;

uniform float wave_speed = 3.0;
uniform float wave_freq = 10.0; 
uniform float wave_width = 1;

uniform float big_wave_speed = 3.0;
uniform float big_wave_freq = 10.0; 
uniform float big_wave_width = 1;

void fragment(){
	vec2 wave_uv_offset;
	wave_uv_offset.x = cos((TIME*wave_speed)+UV.x+UV.y*wave_freq)*wave_width*0.01;
	wave_uv_offset.y = sin((TIME*wave_speed)+UV.x+UV.y*wave_freq)*wave_width*0.01;
	
	//wave_uv_offset.x += cos((TIME/big_wave_speed)+UV.x+UV.y*big_wave_freq)*big_wave_width*0.01;
	//wave_uv_offset.y += sin((TIME/big_wave_speed)+UV.x+UV.y*big_wave_freq)*big_wave_width*0.01;
	
	COLOR = texture(TEXTURE,UV+wave_uv_offset);
}"

